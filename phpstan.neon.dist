includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
    level: 8
    parseModelCastsMethod: true
    # Context configuration is merged with mergeConfigFrom(), so env() there is read when the configuration is cached.
    configDirectories:
        - %rootDir%/../../../config
        - %rootDir%/../../../src/*/Infrastructure/Resources
    cognitive_complexity:
        class: 40
        function: 9
    paths:
        - app
        - src
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database/factories
        - database/migrations
        - database/seeders
        - routes
        - tests
        - behat.php
        - .php-cs-fixer.dist.php
    excludePaths:
        analyse:
            # Fixtures contain the state() calls that disallowedMethodCalls must report.
            - tests/PHPStan/data
    tmpDir: storage/framework/cache/phpstan
    filesRootDir: %rootDir%/../../..
    # Deptrac cannot resolve an unqualified function name inside a namespace, so PHPStan keeps package functions out of the core.
    disallowedFunctionCalls:
        -
            function: '*'
            definedIn:
                - 'vendor/*'
            allowExceptIn:
                - 'src/*/Domain/*'
                - 'src/*/Application/*'
            message: 'Domain and Application must not call a function from an installed package.'
    # ADR-0002: an aggregate's state() is read only by repository implementations and tests.
    disallowedMethodCalls:
        -
            method: 'TradeManeuver\*\Domain\*::state()'
            message: 'the aggregate state is a persistence contract (ADR-0002).'
            allowInInstanceOf:
                - 'TradeManeuver\*\Domain\*RepositoryInterface'
                - 'PHPUnit\Framework\TestCase'
    # Test methods carry the test_ prefix, which php-cs-fixer checks; it does not check methods marked with the attribute.
    disallowedAttributes:
        -
            attribute: 'PHPUnit\Framework\Attributes\Test'
            message: 'name the test method with the test_ prefix instead.'
