includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
    level: 8
    parseModelCastsMethod: true
    # Context configuration is merged with mergeConfigFrom(), so env() there is read when the configuration is cached.
    configDirectories:
        - %rootDir%/../../../config
        - %rootDir%/../../../src/*/Infrastructure/Resources
    cognitive_complexity:
        class: 40
        function: 9
    paths:
        - app
        - src
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database/factories
        - database/migrations
        - database/seeders
        - routes
        - tests
        - behat.php
        - .php-cs-fixer.dist.php
    excludePaths:
        analyse:
            # Rule test fixtures contain the violations the rule must report.
            - tests/PHPStan/Rules/data
    tmpDir: storage/framework/cache/phpstan
    filesRootDir: %rootDir%/../../..
    # Deptrac cannot resolve an unqualified function name inside a namespace, so PHPStan keeps package functions out of the core.
    disallowedFunctionCalls:
        -
            function: '*'
            definedIn:
                - 'vendor/*'
            allowExceptIn:
                - 'src/*/Domain/*'
                - 'src/*/Application/*'
            message: 'Domain and Application must not call a function from an installed package.'
