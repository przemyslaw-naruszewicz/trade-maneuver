APP_NAME="trade-maneuver"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

COMPOSE_PROJECT_NAME=trade-maneuver
APP_PORT=8080
FORWARD_DB_PORT=54320
VITE_PORT=5173
VITE_HOST=localhost
# bin/setup detects the bind mount owner, including rootless Docker.
# LOCAL_UID=1000
# LOCAL_GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=trade_maneuver
DB_USERNAME=trade_maneuver
DB_PASSWORD=local_trade_maneuver_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# RabbitMQ for trade signals and signal outcomes. The users and their passwords are seeded from docker/rabbitmq/rabbitmq.conf
# when the RabbitMQ volume is empty; the user names are fixed there.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=trade-maneuver
RABBITMQ_USER=trade-maneuver
RABBITMQ_PASSWORD=local_trade_maneuver_rabbitmq_password
# Local producer users of the fictional analytics applications.
DEMO_ANALYTICS_RABBITMQ_PASSWORD=local_demo_analytics_password
DEMO_RESEARCH_RABBITMQ_PASSWORD=local_demo_research_password
# The investment configuration that the demo analytics application's trade signals address by default.
DEMO_ANALYTICS_INVESTMENT_CONFIGURATION_REF=demo-investment

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Known analytics applications as `<source>:<RabbitMQ user>` entries, separated by commas: the identifier each one
# sends as `source` and the RabbitMQ user it publishes as.
TRADING_ANALYTICS_APPLICATIONS=demo-analytics:demo-analytics,demo-research:demo-research
