{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["app", "src"],
        // Infection runs only the tests that cover a mutated line. Migration lines are covered by whichever test migrates
        // first, so their mutants say nothing about the schema; PostgreSQL integration tests check it instead.
        "excludes": ["Trading/Infrastructure/Resources/Migrations"]
    },
    "timeout": 15,
    "threads": 1,
    "tmpDir": "storage/framework/testing/infection",
    "initialTestsPhpOptions": "-d pcov.enabled=1",
    "logs": {
        "text": "storage/quality/infection.log",
        "summaryJson": "storage/quality/infection-summary.json"
    },
    "minMsi": 80,
    "minCoveredMsi": 100,
    "ignoreMsiWithNoMutations": false,
    "mutators": {
        "@default": true
    }
}
